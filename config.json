{
// opencode-tg — ajustes del puente.
  //
  // "mode":
  //   off   -> el plugin no hace nada.
  //   dry   -> se suscribe y escribe en ~/.opencode/tg/logs/plugin.log lo que
  //            ENVIARIA, sin tocar el token. El bot antiguo sigue funcionando.
  //   live  -> envia mensajes y hace polling de Telegram. Solo cuando el bot
  //            antiguo este detenido (si no: HTTP 409, dos getUpdates).
  //
  // El token y la lista de usuarios permitidos NO estan aqui: se leen de
  // ~/.opencode/tg/.env (TELEGRAM_BOT_TOKEN, ALLOWED_USERS) para no duplicar
  // el secreto. Ese fichero solo se lee, nunca se escribe.
  "mode": "live",

  // all    -> espeja todas las sesiones que vea el servidor (fase de pruebas).
  // watched -> solo las marcadas con /watch en el chat.
  "mirror": "all",

  // /rebuild recrea los hilos de las sesiones que usaste dentro de estas
  // horas. El server pisa el campo "updated" de TODAS las sesiones al
  // reiniciar, asi que ordenar por ese campo resucitaba sesiones que nadie
  // tocaba hace dias; "idle" es la ultima actividad real. 0 = sin limite.
  "rebuildIdleHours": 24,

  // Vuelca la forma real de los eventos estructurales al log. Apagar tras
  // validar: crece el fichero.
  "debugEvents": false,

  // Transcripcion de notas de voz — cada usuario elige su proveedor:
  //   "local"             -> whisper.cpp en ~/.opencode/tg/stt (sin nube).
  //   "openai-compatible" -> Groq / OpenAI / self-hosted; STT_API_KEY va en
  //                          ~/.opencode/tg/.env, nunca aca.
  "stt": { "provider": "local" },

  "render": {
    // Milisegundos minimos entre ediciones del mismo mensaje.
    // Telegram permite ~1 edicion/segundo por mensaje.
    "editIntervalMs": 1400,

    // Mensaje propio con el diff de cada edit/write.
    "showDiffs": true,
    "diffMaxLines": 40,

    // El "razonamiento" del modelo, tostado y acotado.
    "showReasoning": false,
    "reasoningChars": 1400
  }
}
