{
// opencode-tg — ajustes del puente.
  //
  // "mode":
  //   off   -> el plugin no hace nada.
  //   dry   -> se suscribe y escribe en ~/.opencode/tg/logs/plugin.log lo que
  //            ENVIARIA, sin tocar el token. El bot antiguo sigue funcionando.
  //   live  -> envia mensajes y hace polling de Telegram. Solo cuando el bot
  //            antiguo este detenido (si no: HTTP 409, dos getUpdates).
  //
  // El token y la lista de usuarios permitidos NO estan aqui: se leen de
  // ~/.opencode/tg/.env (TELEGRAM_BOT_TOKEN, ALLOWED_USERS) para no duplicar
  // el secreto. Ese fichero solo se lee, nunca se escribe.
  "mode": "live",

  // all    -> espeja todas las sesiones que vea el servidor (fase de pruebas).
  // watched -> solo las marcadas con /watch en el chat.
  "mirror": "all",

  // Multi-bot: cada token extra (TELEGRAM_BOT_TOKEN_<NOMBRE> en el .env) es
  // otro bot con su propio chat y foro. "topology" decide quién espeja qué:
  //   "single"      -> un solo bot, todo en su foro (el clásico).
  //   "per-project" -> un bot por proyecto: sus sesiones son hilos del foro
  //                    de SU bot. "assign" fija proyecto→bot a mano; el
  //                    resto toma el primer bot libre en su primer turno.
  //   "per-session" -> un bot por sesión: la conversación vive en la raíz
  //                    del chat del bot y los hilos son sus subagentes.
  //                    /release y /archive devuelven el bot al pool.
  // El bot principal (TELEGRAM_BOT_TOKEN) es el hub: espeja todo lo que no
  // tenga bot propio. /bots en cualquier chat muestra el reparto.
  // "bots": {
  //   "topology": "per-project",
  //   "assign": [ { "project": "E:/ruta/al/proyecto", "bot": "SAP" } ]
  // },

  // /rebuild recrea los hilos de las sesiones que usaste dentro de estas
  // horas. El server pisa el campo "updated" de TODAS las sesiones al
  // reiniciar, asi que ordenar por ese campo resucitaba sesiones que nadie
  // tocaba hace dias; "idle" es la ultima actividad real. 0 = sin limite.
  "rebuildIdleHours": 24,

  // Vuelca la forma real de los eventos estructurales al log. Apagar tras
  // validar: crece el fichero.
  "debugEvents": false,

  // Watchdog de prompts muertos (ms): pasado este plazo sin que el turno
  // arranque, el bot lee la cola del log del server y avisa en el hilo la
  // causa real (creditos, rate limit, modelo dado de baja...). Cubre el caso
  // en el que el server falla el drenaje del inbox sin emitir evento ninguno
  // y la conversacion queda muerta. 0 = desactivado. 20s..15min.
  "deadPromptMs": 90000,

  // Transcripcion de notas de voz — cada usuario elige su proveedor:
  //   "local"             -> whisper.cpp en ~/.opencode/tg/stt (sin nube).
  //   "openai-compatible" -> Groq / OpenAI / self-hosted; STT_API_KEY va en
  //                          ~/.opencode/tg/.env, nunca aca.
  "stt": { "provider": "local" },

  // /ci — las runs de GitHub Actions del repo. El token es opcional: el repo
  // es publico y la llamada anonima alcanza (60/hora por IP); GITHUB_TOKEN en
  // ~/.opencode/tg/.env sube el limite y lee repos privados. Un fork cambia
  // el repo aca o con TG_CI_REPO en el .env.
  "ci": { "repo": "par4987/opencode-tg" },

  "render": {
    // Milisegundos minimos entre ediciones del mismo mensaje.
    // Telegram permite ~1 edicion/segundo por mensaje.
    "editIntervalMs": 1400,

    // Mensaje propio con el diff de cada edit/write.
    "showDiffs": true,
    "diffMaxLines": 40,

    // El "razonamiento" del modelo, tostado y acotado.
    "showReasoning": false,
    "reasoningChars": 1400
  }
}
